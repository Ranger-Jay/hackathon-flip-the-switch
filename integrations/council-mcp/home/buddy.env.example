# Buddy home file. Copy outside Git, replace placeholders, keep mode 0600.
# Writes stay off until a separate acceptance GO. Funnel is not configured here.
COUNCIL_MM_URL=https://mattermost.example.invalid
COUNCIL_SWITCH_URL=https://switch.example.invalid
COUNCIL_CHANNEL_ID=REPLACE_WITH_EXISTING_MM_CHANNEL_ID
COUNCIL_ROOM_ID=REPLACE_WITH_EXISTING_SWITCH_ROOM_UUID
COUNCIL_AGENT_ID=REPLACE_WITH_EXISTING_BUDDY_SEAT_UUID
COUNCIL_READER_USER_ID=REPLACE_WITH_SCOPED_MM_READER_ID
COUNCIL_SENDER_USER_ID=REPLACE_WITH_ACTUAL_BRIDGE_SENDER_ID
COUNCIL_HUMAN_USER_IDS='["REPLACE_WITH_JAY_HUMAN_MM_ID"]'
COUNCIL_MM_TOKEN_FILE=${HOME}/council-mcp/buddy/secrets/mattermost.token
COUNCIL_SWITCH_TOKEN_FILE=${HOME}/council-mcp/buddy/secrets/switch.token
COUNCIL_STATE_FILE=${HOME}/council-mcp/buddy/state/receipts.sqlite
COUNCIL_SEAT=buddy
COUNCIL_CORE_SENDER_ID=REPLACE_WITH_BUDDY_CORE_SENDER
COUNCIL_RUNTIME_LABEL=Buddy Main
COUNCIL_OAUTH_CLIENT_ID=chatgpt-council-buddy
COUNCIL_ENABLE_WRITES=false
COUNCIL_MAX_WRITES_HOUR=6
COUNCIL_MAX_WRITES_SOURCE=1
COUNCIL_ALLOW_LOOPBACK_HTTP=false
COUNCIL_TRANSPORT=streamable-http
COUNCIL_PORT=8787
# Candidate only. Do not treat this as a wired Funnel route.
COUNCIL_PUBLIC_URL=https://nexus.tail3b496f.ts.net
COUNCIL_OAUTH_ISSUER=https://auth.example.invalid/realms/council/
