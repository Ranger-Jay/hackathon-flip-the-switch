# Finch home file. Separate from Buddy: other port, client, sender, state and seat key.
# The Buddy origin https://nexus.tail3b496f.ts.net must not be copied here.
# Writes stay off. Funnel is not configured here.
COUNCIL_MM_URL=https://mattermost.example.invalid
COUNCIL_SWITCH_URL=https://switch.example.invalid
COUNCIL_CHANNEL_ID=REPLACE_WITH_EXISTING_MM_CHANNEL_ID
COUNCIL_ROOM_ID=REPLACE_WITH_EXISTING_SWITCH_ROOM_UUID
COUNCIL_AGENT_ID=REPLACE_WITH_EXISTING_FINCH_SEAT_UUID
COUNCIL_READER_USER_ID=REPLACE_WITH_SCOPED_MM_READER_ID
COUNCIL_SENDER_USER_ID=REPLACE_WITH_ACTUAL_BRIDGE_SENDER_ID
COUNCIL_HUMAN_USER_IDS='["REPLACE_WITH_JAY_HUMAN_MM_ID"]'
COUNCIL_MM_TOKEN_FILE=${HOME}/council-mcp/finch/secrets/mattermost.token
COUNCIL_SWITCH_TOKEN_FILE=${HOME}/council-mcp/finch/secrets/switch.token
COUNCIL_STATE_FILE=${HOME}/council-mcp/finch/state/receipts.sqlite
COUNCIL_SEAT=finch
COUNCIL_CORE_SENDER_ID=REPLACE_WITH_FINCH_CORE_SENDER
COUNCIL_RUNTIME_LABEL=Finch
COUNCIL_OAUTH_CLIENT_ID=council-finch
COUNCIL_ENABLE_WRITES=false
COUNCIL_MAX_WRITES_HOUR=6
COUNCIL_MAX_WRITES_SOURCE=1
COUNCIL_ALLOW_LOOPBACK_HTTP=false
COUNCIL_TRANSPORT=streamable-http
COUNCIL_PORT=8788
# Candidate only: distinct port, still unwired. Path-prefix mounting is not supported.
COUNCIL_PUBLIC_URL=https://nexus.tail3b496f.ts.net:8444
COUNCIL_OAUTH_ISSUER=https://auth.example.invalid/realms/council/
COUNCIL_OAUTH_JWKS_URL=https://auth.example.invalid/realms/council/jwks
COUNCIL_OAUTH_SUBJECTS='["REPLACE_WITH_FINCH_OAUTH_SUBJECT"]'
