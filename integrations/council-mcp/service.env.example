# Template only. Replace privately; never commit the configured copy or keys.
# Credential/state directories must be service-owned 0700; files 0600.
COUNCIL_MM_URL=https://mattermost.example.invalid
COUNCIL_SWITCH_URL=https://switch.example.invalid
COUNCIL_CHANNEL_ID=REPLACE_WITH_EXISTING_MM_CHANNEL_ID
COUNCIL_ROOM_ID=REPLACE_WITH_EXISTING_SWITCH_ROOM_UUID
COUNCIL_AGENT_ID=REPLACE_WITH_EXISTING_BUDDY_SEAT_UUID
COUNCIL_READER_USER_ID=REPLACE_WITH_SCOPED_MM_READER_ID
COUNCIL_SENDER_USER_ID=REPLACE_WITH_ACTUAL_BRIDGE_SENDER_ID
COUNCIL_HUMAN_USER_IDS='["REPLACE_WITH_JAY_HUMAN_MM_ID"]'
COUNCIL_MM_TOKEN_FILE=/etc/council-mcp/secrets/mattermost.token
COUNCIL_SWITCH_TOKEN_FILE=/etc/council-mcp/secrets/switch.token
COUNCIL_STATE_FILE=/var/lib/council-mcp/receipts.sqlite
# One process, one seat. buddy and finch are separate env files, state files,
# seat keys, subject allowlists and public clients. Do not copy this file for Finch.
COUNCIL_SEAT=buddy
COUNCIL_CORE_SENDER_ID=REPLACE_WITH_THIS_SEAT_CORE_SENDER
COUNCIL_OAUTH_CLIENT_ID=chatgpt-council-buddy
COUNCIL_RUNTIME_LABEL='Buddy Main'
COUNCIL_ENABLE_WRITES=false
COUNCIL_MAX_WRITES_HOUR=6
COUNCIL_MAX_WRITES_SOURCE=1
COUNCIL_ALLOW_LOOPBACK_HTTP=false
COUNCIL_TRANSPORT=streamable-http
COUNCIL_PORT=8787
# Buddy candidate origin. Finch must use a different origin, for example
# https://nexus.tail3b496f.ts.net:8444 — never this Buddy URL. Funnel is not wired here.
COUNCIL_PUBLIC_URL=https://council.example.invalid
COUNCIL_OAUTH_ISSUER=https://auth.example.invalid/realms/council/
COUNCIL_OAUTH_JWKS_URL=https://auth.example.invalid/realms/council/jwks
COUNCIL_OAUTH_SUBJECTS='["REPLACE_WITH_APPROVED_ORIGINAL_CHAT_OAUTH_SUBJECT"]'
